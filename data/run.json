    "sample_removed": [
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092c\u093f\u0939\u093e\u0930 \u0915\u0947 \u0932\u0916\u0940\u0938\u0930\u093e\u092f \u092e\u0947\u0902 \u0939\u0941\u0908 \u0926\u0941\u0930\u094d\u092d\u093e\u0917\u094d\u092f\u092a\u0942\u0930\u094d\u0923 \u0918\u091f\u0928\u093e \u0915\u0947 \u092a\u0940\u0921\u093c\u093f\u0924\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0930\u093e\u0937\u094d\u200d\u091f\u094d\u0930\u0940\u092f \u0930\u093e\u0939\u0924 \u0915\u094b\u0937 \u0938\u0947 \u0905\u0928\u0941\u0917\u094d\u0930\u0939 \u0930\u093e\u0936\u093f \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2300467",
      "\u092e\u094b\u0926\u0940 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0926\u093f\u0935\u0938 \u0938\u0947 \u092a\u0939\u0932\u0947 ISI \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0906\u0924\u0902\u0915\u0940 \u0938\u092e\u0942\u0939 '\u0936\u0939\u091c\u093c\u093e\u0926 \u092d\u091f\u094d\u091f\u0940 \u0928\u0947\u091f\u0935\u0930\u094d\u0915' \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930 \u0926\u093f\u092f\u093e \u0914\u0930 200 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u0926\u0938\u094d\u092f\u094b\u0902 \u0915\u094b \u0917\u093f\u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0915\u0930 \u0909\u0938\u0915\u0947 \u0916\u0924\u0930\u0928\u093e\u0915 \u0939\u092e\u0932\u094b\u0902 \u0915\u0947 \u092e\u0902\u0938\u0942\u092c\u094b\u0902 \u0915\u094b \u0928\u093e\u0915\u093e\u092e \u0915\u0930 \u0926\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2300406",
      "\u092e\u0924\u094d\u0938\u094d\u092f \u0935\u093f\u092d\u093e\u0917 \u0928\u0947 80\u0935\u093e\u0902 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0926\u093f\u0935\u0938 \u092e\u0928\u093e\u092f\u093e, \u092e\u0924\u094d\u0938\u094d\u092f \u092a\u093e\u0932\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u094b \u0938\u0936\u0915\u094d\u0924 \u092c\u0928\u093e\u0928\u0947 \u0924\u0925\u093e \u0928\u0940\u0932\u0940 \u0905\u0930\u094d\u0925\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927\u0924\u093e \u0926\u094b\u0939\u0930\u093e\u0908",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2300422",
      "\u0930\u0915\u094d\u0937\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0928\u094c\u0938\u0947\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0926\u094b \u090f\u092e\u0915\u094d\u200d\u092f\u0942-9\u092c\u0940 \u0938\u0940 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928 \u0939\u093e\u0908-\u090f\u0932\u094d\u091f\u0940\u091f\u094d\u092f\u0942\u0921 \u0932\u0949\u0928\u094d\u0917-\u090f\u0902\u0921\u094d\u092f\u094b\u0930\u0947\u0902\u0938 \u0930\u093f\u092e\u094b\u091f\u0932\u0940 \u092a\u093e\u092f\u0932\u0947\u091f\u0947\u0921 \u090f\u092f\u0930\u0915\u094d\u0930\u093e\u092b\u094d\u091f \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b 30 \u092e\u0939\u0940\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u0940\u091c \u092a\u0930 \u0932\u0947\u0928\u0947 \u0939\u0947\u0924\u0941 \u091c\u0928\u0930\u0932 \u090f\u091f\u0949\u092e\u093f\u0915\u094d\u0938 \u090f\u0930\u094b\u0928\u0949\u091f\u093f\u0915\u0932 \u0938\u093f\u0938\u094d\u091f\u092e\u094d\u0938, \u0907\u0902\u0915. \u0915\u0947 \u0938\u093e\u0925 \u0905\u0928\u0941\u092c\u0902\u0927 \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0915\u093f\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2300432"
