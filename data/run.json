      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302778",
      "27 \u0905\u0917\u0938\u094d\u0924, 2026 \u0915\u094b \u0926\u0947\u0936 \u092d\u0930 \u092e\u0947\u0902 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0916\u0947\u0932 \u0926\u093f\u0935\u0938 \u0916\u0947\u0932\u094b \u0907\u0902\u0921\u093f\u092f\u093e \u0921\u093e\u092f\u0932\u0949\u0917 - \u0916\u0947\u0932 \u0915\u0940 \u092c\u093e\u0924, \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0917\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302797",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u093f\u0924\u094d\u0924 \u0914\u0930 \u0915\u0949\u0930\u094d\u092a\u094b\u0930\u0947\u091f \u0915\u093e\u0930\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940\u092e\u0924\u0940 \u0928\u093f\u0930\u094d\u092e\u0932\u093e \u0938\u0940\u0924\u093e\u0930\u092e\u0923 25 \u0905\u0917\u0938\u094d\u0924 \u0938\u0947 2 \u0938\u093f\u0924\u0902\u092c\u0930, 2026 \u0924\u0915 \u0915\u0928\u093e\u0921\u093e \u0914\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u0930\u0939\u0947\u0902\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302823",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u092d\u0942\u092a\u0947\u0902\u0926\u094d\u0930 \u092f\u093e\u0926\u0935 \u0928\u0947 \u092e\u0902\u0917\u094b\u0932\u093f\u092f\u093e \u0915\u0947 \u0909\u0932\u093e\u0928\u092c\u091f\u093e\u0930 \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u092f\u0942\u090f\u0928\u0938\u0940\u0938\u0940\u0921\u0940 \u0938\u0940\u0913\u092a\u094017 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u092d\u093e\u0930\u0924 \u0928\u0947 \u0935\u0930\u094d\u0937 2011-2020 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 21.76 \u092e\u093f\u0932\u093f\u092f\u0928 \u0939\u0947\u0915\u094d\u091f\u0947\u092f\u0930 \u092d\u0942\u092e\u093f \u0915\u093e \u091c\u0940\u0930\u094d\u0923\u094b\u0926\u094d\u0927\u093e\u0930 \u0915\u093f\u092f\u093e, \u091c\u093f\u0938\u0938\u0947 1.22 \u092c\u093f\u0932\u093f\u092f\u0928 \u0935\u094d\u092f\u0915\u094d\u0924\u093f-\u0926\u093f\u0935\u0938 \u0930\u094b\u091c\u0917\u093e\u0930 \u0938\u0943\u091c\u093f\u0924 \u0939\u0941\u0906",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302717"
    ],
    "diff": "@@ -1,3 +1,13 @@\n+\u0938\u0940\u090f\u0938\u0906\u0908\u0906\u0930-\u0938\u0940\u0906\u0930\u0906\u0930\u0906\u0908 \u0928\u0947 \u0938\u0921\u093c\u0915 \u092a\u0930\u093f\u0938\u0902\u092a\u0924\u094d\u0924\u093f \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0914\u0930 \u092a\u0942\u0930\u094d\u0935\u093e\u0928\u0941\u092e\u093e\u0928 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u092a\u0930 \u090f\u0915 \u0926\u093f\u0935\u0938\u0940\u092f \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e\n+    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302975\n \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0917\u0943\u0939 \u090f\u0935\u0902 \u0938\u0939\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0905\u092e\u093f\u0924 \u0936\u093e\u0939 \u0928\u0947 \u0906\u091c \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0926\u094b \u0926\u093f\u0935\u0938\u0940\u092f \u0928\u094c\u0935\u0947\u0902 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0930\u0923\u0928\u0940\u0924\u093f \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u2013 2026 \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u093f\u092f\u093e\n     https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2302942\n+\u0915\u0947\u0928\u094d\u200d\u0926\u094d\u0930\u0940\u092f \u0928\u093e\u0930\u0915\u094b\u091f\u093f\u0915\u094d\u0938 \u092c\u094d\u092f\u0942\u0930\u094b (\u0938\u0940\u092c\u0940\u090f\u0928) \u0914\u0930 \u092b\u093e\u0930\u094d\u092e\u0947\u0915\u094d\u0938\u093f\u0932 \u0928\u0947 \u0935\u0948\u0927 \u0914\u0937\u0927\u0940\u092f \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u0947 \u0924\u0925\u093e \u092