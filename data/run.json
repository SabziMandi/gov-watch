    "sample_added": [
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0928\u0930\u0947\u0928\u094d\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0928\u0947 \u091c\u0928\u094d\u092e\u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u094d\u0935 \u0928\u0947\u0924\u093e\u0913\u0902 \u0915\u093e \u0906\u092d\u093e\u0930 \u092a\u094d\u0930\u0915\u091f \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311789",
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u0913\u0902, \u0938\u094d\u0928\u0947\u0939 \u0914\u0930 \u0906\u0936\u0940\u0930\u094d\u0935\u093e\u0926 \u0915\u0947 \u0932\u093f\u090f \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u0906\u092d\u093e\u0930 \u0935\u094d\u092f\u0915\u094d\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311790",
      "\u0915\u0947\u0935\u0940\u0906\u0908\u0938\u0940 \u0915\u0947 \u0905\u0927\u094d\u092f\u0915\u094d\u0937 \u0936\u094d\u0930\u0940 \u092e\u0928\u094b\u091c \u0917\u094b\u092f\u0932 \u0914\u0930 \u0926\u093f\u0932\u094d\u0932\u0940 \u0915\u0947 \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u092f\u0930 \u0936\u094d\u0930\u0940 \u091c\u092f \u092a\u094d\u0930\u0915\u093e\u0936 \u0928\u0947 '\u0938\u0947\u0935\u093e \u0938\u0902\u0915\u0932\u094d\u092a, \u0916\u093e\u0926\u0940 \u092e\u0939\u094b\u0924\u094d\u0938\u0935-2026' \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311793",
      "'\u0906\u0936\u0940\u0930\u094d\u0935\u093e\u0926 \u0915\u093e \u0926\u0940\u092f\u093e' \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0936\u093e \u0914\u0930 \u0906\u0924\u094d\u092e\u0928\u093f\u0930\u094d\u092d\u0930\u0924\u093e \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311786",
      "\u092d\u093e\u0930\u0924\u0940\u092f \u092b\u093e\u0930\u094d\u092e\u093e\u0915\u094b\u092a\u093f\u092f\u093e \u0906\u092f\u094b\u0917 \u0928\u0947 \u0926\u0935\u093e\u0913\u0902 \u0915\u0947 \u0924\u0930\u094d\u0915\u0938\u0902\u0917\u0924 \u0909\u092a\u092f\u094b\u0917 \u092a\u0930 \u092c\u0932 \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u091b\u0920\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092b\u093e\u0930\u094d\u092e\u093e\u0915\u094b\u0935\u093f\u091c\u093f\u0932\u0947\u0902\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u093e \u0936\u0941\u092d\u093e\u0930\u0902\u092d \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311795",
      "\u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0926\u0947\u0936 \u0915\u0947 \u0939\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u090f\u0915 \u0938\u092e\u093e\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927 \u0939\u0948: \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0930\u093e\u091c\u0940\u0935 \u0930\u0902\u091c\u0928 \u0938\u093f\u0902\u0939",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311796",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u091c\u0947.\u092a\u0940. \u0928\u0921\u094d\u0921\u093e \u0928\u0947 \u0921\u0949. \u0906\u0930\u090f\u092e\u090f\u0932 \u0905\u0938\u094d\u092a\u0924\u093e\u0932 \u092e\u0947\u0902 '\u0935\u093f\u0936\u094d\u0935 \u0930\u094b\u0917\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0926\u093f\u0935\u0938 2026' \u0915\u0947 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u094b \u0938\u0902\u092c\u094b\u0927\u093f\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311788",
      "\u0938\u0947\u0935\u093e \u0938\u0902\u0915\u0932\u094d\u092a \u0905\u092d\u093f\u092f\u093e\u0928 \u0928\u093e\u0917\u0930\u093f\u0915-\u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0936\u093e\u0938\u0928 \u0914\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930-\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0940 \u092d\u093e\u0935\u0928\u093e \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948: \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0928\u093f\u0924\u093f\u0928 \u0917\u0921\u0915\u0930\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311794",
      "\u0938\u0940\u0938\u0940\u0906\u0908 \u0928\u0947 \u0913\u090f\u092e\u0908\u0906\u0930\u090f\u0938 \u0907\u0902\u092b\u094d\u0930\u093e\u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930 \u090f\u0936\u093f\u092f\u093e \u0939\u094b\u0932\u094d\u0921\u093f\u0902\u0917\u094d\u0938 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0926\u094d\u0935\u093e\u0930\u093e \u090f\u091c\u093c\u094d\u092f\u094b\u0930 \u092a\u093e\u0935\u0930 \u0917\u094d\u0932\u094b\u092c\u0932 \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u0947\u0902 \u0915\u0941\u091b \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0947\u092f\u0930\u0927\u093e\u0930\u093f\u0924\u093e \u0915\u0947 \u0905\u0927\u093f\u0917\u094d\u0930\u0939\u0923 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311783",
      "\u0938\u0940\u0938\u0940\u0906\u0908 \u0928\u0947 \u0906\u0908\u090f\u0938\u090f\u090f\u092b III \u0911\u0928\u0936\u094b\u0930 \u092b\u0902\u0921, \u0907\u0902\u0921\u093f\u092f\u093e \u0938\u094d\u092a\u0947\u0936\u0932 \u090f\u0938\u0947\u091f\u094d\u0938 \u092b\u0902\u0921 III, \u0938\u094d\u092a\u0947\u0936\u0932 \u0938\u093f\u091a\u0941\u090f\u0936\u0928 \u092b\u0902\u0921 \u0914\u0930 \u0905\u0928\u094d\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0917\u094d\u0930\u0947\u091f \u0935\u094d\u0939\u093e\u0907\u091f \u0917\u094d\u0932\u094b\u092c\u0932 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0915\u0940 \u0915\u0941\u091b \u0907\u0915\u094d\u0935\u093f\u091f\u0940 \u0936\u0947\u092f\u0930 \u092a\u0942\u0902\u091c\u0940 \u0915\u0947 \u0905\u0927\u093f\u0917\u094d\u0930\u0939\u0923 \u090f\u0935\u0902 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0932\u0947\u0928-\u0926\u0947\u0928 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311782",
      "\u0938\u0940\u0938\u0940\u0906\u0908 \u0928\u0947 \u0935\u0947\u0938\u094d\u091f\u0935\u094d\u092f\u0942 \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0914\u0930 \u092a\u0942\u0928\u093e\u0935\u093e\u0932\u093e \u0938\u094d\u092a\u094b\u0930\u094d\u091f\u094d\u0938 \u090f\u0902\u0921 \u092b\u093f\u091f\u0928\u0947\u0938 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u0940\u0928 \u092a\u0947\u0936\u0947\u0935\u0930 \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u092b\u094d\u0930\u0947\u0902\u091a\u093e\u0907\u091c\u0940\u2014\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0930\u0949\u092f\u0932\u094d\u0938 (\u092d\u093e\u0930\u0924), \u092a\u093e\u0930\u094d\u0932 \u0930\u0949\u092f\u0932\u094d\u0938 (\u0926\u0915\u094d\u0937\u093f\u0923 \u0905\u092b\u094d\u0930\u0940\u0915\u093e) \u0914\u0930 \u092c\u093e\u0930\u092c\u093e\u0921\u094b\u0938 \u0930\u0949\u092f\u0932\u094d\u0938 (\u092c\u093e\u0930\u092c\u093e\u0921\u094b\u0938)\u2014\u0915\u0947 \u0905\u0927\u093f\u0917\u094d\u0930\u0939\u0923 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311784",
      "\u0935\u094d\u092f\u092f \u0935\u093f\u092d\u093e\u0917 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0905\u092d\u093f\u092f\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930",
