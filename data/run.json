      "\u0926\u093f\u0932\u094d\u0932\u0940 \u0939\u093e\u091f \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u2018\u0936\u093f\u0932\u094d\u092a \u0938\u092e\u093e\u0917\u092e \u092e\u0947\u0932\u093e 2026\u2019 \u092e\u0947\u0902 \u0915\u0941\u0932 64.52 \u0932\u093e\u0916 \u0930\u0941\u092a\u092f\u0947 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0940 \u092c\u093f\u0915\u094d\u0930\u0940 \u0939\u0941\u0908, \u091c\u094b \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0936\u093e\u0928\u0926\u093e\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u0915\u093e\u0930\u0940\u0917\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u091c\u093e\u0930 \u0915\u0947 \u092c\u0922\u093c\u0924\u0947 \u0905\u0935\u0938\u0930\u094b\u0902 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948",
