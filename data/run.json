      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311791",
      "\u0921\u093e\u0915 \u0935\u093f\u092d\u093e\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0915\u094b \u0938\u0902\u0938\u094d\u0925\u093e\u0917\u0924 \u092c\u0928\u093e\u0928\u0947, \u0932\u0902\u092c\u093f\u0924 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u094b \u0915\u092e \u0915\u0930\u0928\u0947 \u0914\u0930 \u0908-\u0915\u091a\u0930\u0947 \u0915\u0947 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0928\u093f\u092a\u091f\u093e\u0928 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u0947\u0937 \u0905\u092d\u093f\u092f\u093e\u0928 6 \u091a\u0932\u093e\u092f\u093e \u091c\u093e\u090f\u0917\u093e",
