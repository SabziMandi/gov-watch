    "sample_added": [
      "\u092a\u0936\u0941\u092a\u093e\u0932\u0928 \u0914\u0930 \u0921\u0947\u092f\u0930\u0940 \u0935\u093f\u092d\u093e\u0917 (\u0921\u0940\u090f\u090f\u091a\u0921\u0940) \u0928\u0947 \u0932\u0902\u092a\u0940 \u0938\u094d\u0915\u093f\u0928 (\u0936\u0930\u0940\u0930 \u092a\u0930 \u0917\u093e\u0902\u0920) \u092c\u0940\u092e\u093e\u0930\u0940 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0917\u0930\u093e\u0928\u0940, \u091f\u0940\u0915\u093e\u0915\u0930\u0923 \u0914\u0930 \u0930\u094b\u0917-\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0909\u092a\u093e\u092f\u094b\u0902 \u0915\u094b \u0938\u0941\u0926\u0943\u0922\u093c \u0915\u093f\u092f\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308118",
      "\u092a\u0943\u0925\u094d\u0935\u0940 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0914\u0930 \u090f\u0928\u0906\u0908\u0913\u091f\u0940 \u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0916\u0928\u093f\u091c \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0917\u0939\u0930\u0947 \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0947\u0902 \u0916\u0928\u0928 \u092a\u0930 \u0909\u0926\u094d\u092f\u094b\u0917 \u091c\u0917\u0924 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308113",
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0928\u0930\u0947\u0928\u094d\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0928\u0947 \u092e\u0941\u0902\u092c\u0908 \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u2018\u0917\u094d\u0932\u094b\u092c\u0932 \u092b\u093f\u0928\u091f\u0947\u0915 \u092b\u0947\u0938\u094d\u091f 2026\u2019 \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308117",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0936\u093f\u0915\u094d\u0937\u093e \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u091c\u092f\u0902\u0924 \u091a\u094c\u0927\u0930\u0940 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0938\u093e\u0915\u094d\u0937\u0930\u0924\u093e \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u093e \u0915\u0940 \u092a\u0930\u093f\u0915\u0932\u094d\u092a\u0928\u093e \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0914\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u093e\u0917\u0930\u093f\u0915\u0924\u093e \u0915\u0947 \u0938\u093e\u0927\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u0940 \u091c\u093e\u0928\u0940 \u091a\u093e\u0939\u093f\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308115",
      "\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u090f\u0935\u0902 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0921\u0947\u091f\u093e-\u0906\u0927\u093e\u0930\u093f\u0924 \u0936\u093e\u0938\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0921\u0947\u091f\u093e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0939\u0947\u0924\u0941 \u0906\u0902\u0915\u0921\u093c\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0902\u091c\u0938\u094d\u092f \u092a\u0930 \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308116",
      "\u092d\u093e\u0930\u0924 \u0928\u0947 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e, \u0928\u0930\u094d\u0938\u093f\u0902\u0917 \u0914\u0930 \u0938\u0902\u092c\u0926\u094d\u0927 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e \u0915\u0930\u094d\u092e\u093f\u092f\u094b\u0902 \u0915\u094b \u092c\u0922\u093c\u093e\u0928\u0947 \u092a\u0930 \u091c\u094b\u0930 \u0926\u093f\u092f\u093e; \u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u091a\u0913 \u0906\u0930\u0938\u094079 \u092e\u0947\u0902 \u0917\u094d\u0930\u093e\u092e\u0940\u0923, \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u0914\u0930 \u0935\u0902\u091a\u093f\u0924 \u0906\u092c\u093e\u0926\u0940 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e\u0913\u0902 \u0924\u0915 \u0938\u092e\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927\u0924\u093e \u0926\u094b\u0939\u0930\u093e\u0908",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308114"
    ],
    "sample_removed": [
      "\u092a\u0939\u093e\u0921\u093c\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u092a\u0936\u0941\u0927\u0928 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u092e\u0947\u0902 \u090f\u0906\u0908 \u0938\u0947 \u0928\u0908 \u092a\u0939\u0932, \u092f\u0939 \u0924\u0915\u0928\u0940\u0915 \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u0947 \u0905\u092a\u0928\u0947 \u092a\u0936\u0941\u0927\u0928 \u0915\u0947 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0947 \u0924\u0930\u0940\u0915\u0947 \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948",
