    "type": "change",
    "added": 10,
    "removed": 10,
    "sample_added": [
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0938\u092e\u0943\u0926\u094d\u0927 \u0939\u0925\u0915\u0930\u0918\u093e \u0935\u093f\u0930\u093e\u0938\u0924 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0939\u0925\u0915\u0930\u0918\u093e \u0926\u093f\u0935\u0938 \u092e\u0928\u093e\u0928\u0947 \u0915\u093e \u0906\u0939\u094d\u0935\u093e\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2295833",
      "\u0915\u0943\u0937\u093f \u0914\u0930 \u092a\u094d\u0930\u0938\u0902\u0938\u094d\u0915\u0943\u0924 \u0916\u093e\u0926\u094d\u092f \u0909\u0924\u094d\u092a\u093e\u0926 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0935\u093f\u0915\u093e\u0938 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 (\u090f\u092a\u0940\u0908\u0921\u0940\u090f) \u092d\u093e\u0930\u0924 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u091c\u0948\u0935\u093f\u0915 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u0947 \u0914\u0930 \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u092c\u093e\u091c\u093e\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u092f\u094b\u092b\u0948\u091a (BIOFACH) \u0907\u0902\u0921\u093f\u092f\u093e 2026 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2295835",
      "\u0935\u0940\u0938\u0940\u090f\u092b-\u090f\u0938\u091f\u0940 \u0915\u0947 \u0924\u0939\u0924 \u0932\u0917\u092d\u0917 1,000 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u091c\u0928\u091c\u093e\u0924\u093f \u0915\u0947 \u0909\u0926\u094d\u092f\u092e\u093f\u092f\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0915\u0940 \u091c\u093e\u090f\u0917\u0940, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e 100 \u0915\u094b \u0935\u093f\u0924\u094d\u0924 \u092a\u094b\u0937\u093f\u0924 \u0914\u0930 \u0907\u0928\u0915\u094d\u092f\u0942\u092c\u0947\u0936\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u0926\u0940 \u091c\u093e\u090f\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2295832",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u090f\u0935\u0902 \u092a\u0930\u094d\u092f\u091f\u0928 \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0917\u091c\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0936\u0947\u0916\u093e\u0935\u0924 \u0928\u0947 '\u0939\u0930 \u0918\u0930 \u0924\u093f\u0930\u0902\u0917\u093e 2026' \u0905\u092d\u093f\u092f\u093e\u0928 \u0915\u093e \u0936\u0941\u092d\u093e\u0930\u0902\u092d \u0915\u093f\u092f\u093e; \u092f\u0939 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0935\u094d\u092f\u093e\u092a\u0940 \u0905\u092d\u093f\u092f\u093e\u0928 9 \u0938\u0947 17 \u0905\u0917\u0938\u094d\u0924, 2026 \u0924\u0915 \u091a\u0932\u093e\u092f\u093e \u091c\u093e\u090f\u0917\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2295831",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0938\u0930\u094d\u092c\u093e\u0928\u0902\u0926 \u0938\u094b\u0928\u094b\u0935\u093e\u0932 \u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u0947 \u092a\u0924\u094d\u0924\u0928 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u0941\u0926\u094d\u0930\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0922\u093e\u0902\u091a\u0947 \u092a\u0930 \u091c\u094b\u0930 \u0926\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2295830"
    ],
