    "sample_added": [
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0917\u0943\u0939 \u090f\u0935\u0902 \u0938\u0939\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0905\u092e\u093f\u0924 \u0936\u093e\u0939 \u0928\u0947 \u0932\u0926\u094d\u0926\u093e\u0916 \u092e\u0947\u0902 \u091c\u092e\u094d\u092e\u0942-\u0915\u0936\u094d\u092e\u0940\u0930 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0940 \u092a\u0940\u0920 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0915\u0947 \u0928\u093f\u0930\u094d\u0923\u092f \u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301699",
      "\u092e\u0941\u0902\u092c\u0908 \u0909\u092a\u0928\u0917\u0930\u0940\u092f \u0930\u0947\u0932\u0935\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u092f \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0906\u0908\u0938\u0940\u090f\u092b, \u0906\u0930\u0938\u0940\u090f\u092b \u0914\u0930 \u090f\u092e\u0938\u0940\u090f\u092b 238 \u090f\u0938\u0940 \u0908\u090f\u092e\u092f\u0942 \u0930\u0947\u0915\u094b\u0902 \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0917\u0947",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301682",
      "\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u092c\u093e\u0927\u093e\u0913\u0902 \u0938\u0947 \u0936\u094b\u0927 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0924\u0915: \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u090f\u0928\u090f\u092b\u090f\u0938\u0938\u0940 \u092e\u0926\u0926 \u0928\u0947 \u0924\u0930\u0941\u0923 \u0915\u0941\u092e\u093e\u0930 \u0915\u0940 \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301681",
      "\u0906\u0930\u094d\u0925\u093f\u0915 \u0924\u0902\u0917\u0940 \u0938\u0947 \u0938\u093e\u092e\u0942\u0939\u093f\u0915 \u0909\u0926\u094d\u092f\u092e\u093f\u0924\u093e \u0924\u0915: \u090f\u0928\u092c\u0940\u0938\u0940\u090f\u092b\u0921\u0940\u0938\u0940 \u092e\u093e\u0907\u0915\u094d\u0930\u094b \u092b\u093e\u0907\u0928\u0947\u0902\u0938 \u0938\u0939\u093e\u092f\u0924\u093e \u0928\u0947 \u092c\u0940\u0928\u093e \u0914\u0930 \u0909\u0928\u093e\u0930\u094d\u0935\u0941 \u0938\u094d\u0935\u092f\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u092e\u0942\u0939 (\u090f\u0938\u090f\u091a\u091c\u0940) \u0915\u094b \u090f\u0915 \u0938\u092b\u0932 \u0915\u0948\u091f\u0930\u093f\u0902\u0917 \u0909\u0926\u094d\u092f\u092e \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301706",
      "\u0921\u0940\u0921\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u0938 \u0928\u0947 \u091c\u0932 \u091c\u0940\u0935\u0928 \u092e\u093f\u0936\u0928 2.0 \u0915\u0947 \u0924\u0939\u0924 \u0915\u094d\u0937\u092e\u0924\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u0908 \u0939\u093f\u0924\u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092a\u0930 \u090f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301692",
      "\u092c\u094d\u0930\u093f\u0915\u094d\u0938 \u092e\u0939\u093e\u0938\u093e\u0917\u0930 \u0914\u0930 \u0927\u094d\u0930\u0941\u0935\u0940\u092f \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u090f\u0935\u0902 \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0915\u093e\u0930\u094d\u092f \u0938\u092e\u0942\u0939 \u0915\u0940 8\u0935\u0940\u0902 \u092c\u0948\u0920\u0915",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301704"
    ],
    "sample_removed": [
      "\u0938\u094d\u091f\u0940\u0932 \u0905\u0925\u0949\u0930\u093f\u091f\u0940 \u0911\u092b \u0907\u0923\u094d\u0921\u093f\u092f\u093e \u0932\u093f\u092e\u093f\u091f\u0947\u0921 (SAIL) \u0928\u0947 \u090f\u092e\u090f\u092e\u0921\u0940\u0906\u0930 \u0938\u0902\u0936\u094b\u0927\u0928 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2026 \u0915\u093e \u0915\u093f\u092f\u093e \u0938\u094d\u0935\u093e\u0917\u0924, \u092c\u0924\u093e\u092f\u093e \u0916\u0928\u093f\u091c \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0918\u0930\u0947\u0932\u0942 \u0932\u094c\u0939 \u0905\u092f\u0938\u094d\u0915 \u0915\u0940 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u092c\u0921\u093c\u093e \u0938\u0941\u0927\u093e\u0930",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301520",
      "\u091f\u0940\u0921\u0940\u092c\u0940-\u0921\u0940\u090f\u0938\u091f\u0940 \u0928\u0947 \u0926\u093f\u0932\u094d\u0932\u0940 \u0938\u094d\u0925\u093f\u0924 \u092e\u0947\u0938\u0930\u094d\u0938 \u0935\u09282\u090f\u0915\u094d\u0938 \u091f\u0947\u0915 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0915\u094b \u0938\u094d\u0935\u0926\u0947\u0936\u0940 \u090f\u091c\u0947\u0902\u091f\u093f\u0915 \u090f\u0906\u0908 \u0924\u0915\u0928\u0940\u0915 \u0915\u0947 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092f\u094b\u0917 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301650",
      "\u0928\u093e\u0917\u093e\u0932\u0948\u0902\u0921 \u0915\u0947 \u0909\u092a\u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u092f\u093e\u0928\u0925\u0941\u0902\u0917\u094b \u092a\u0948\u091f\u0928 \u0928\u0947 \u0921\u0949. \u091c\u093f\u0924\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940; \u092a\u0942\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u0930 \u092e\u0947\u0902 \u0935\u093f\u0915\u093e\u0938 \u0914\u0930 \u0915\u0928\u0947\u0915\u094d\u091f\u093f\u0935\u093f\u091f\u0940 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301600",
      "\u0935\u0930\u093f\u0937\u094d\u0920 \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0915\u093e\u0930\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092e\u0948\u0930\u0940 \u091c\u094b\u090f\u0932 \u0938\u0948\u0902\u0921\u094d\u0930\u093f\u0928 \u0935\u0932\u0947\u0930\u0947 \u0915\u0947 \u0928\u0947\u0924\u0943\u0924\u094d\u0935 \u092e\u0947\u0902 \u092e\u0949\u0930\u0940\u0936\u0938 \u0915\u0947 \u0935\u0930\u093f\u0937\u094d\u0920 \u0932\u094b\u0915 \u0938\u0947\u0935\u0915\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092e\u0902\u0921\u0932 \u0928\u0947 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0921\u0949. \u091c\u093f\u0924\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940; \u092f\u0939 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092e\u0902\u0921\u0932 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0936\u093e\u0938\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 (\u090f\u0928\u0938\u0940\u091c\u0940\u091c\u0940) \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u094d\u0937\u092e\u0924\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947 \u0930\u0939\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301643",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u090f\u0935\u0902 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0932\u094d\u092f\u093e\u0923 \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u092e\u093f\u0936\u0928 \u0915\u0930\u094d\u092e\u092f\u094b\u0917\u0940 \u0935\u093f\u0915\u093e\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092e\u093f\u0936\u0928 \u0915\u0930\u094d\u092e\u092f\u094b\u0917\u0940 \u092a\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u093e \u0936\u0941\u092d\u093e\u0930\u0902\u092d \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301562",
      "\u0909\u092a\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0936\u094d\u0930\u0940 \u0938\u0940\u092a\u0940 \u0930\u093e\u0927\u093e\u0915\u0943\u0937\u094d\u0923\u0928 \u0928\u0947 \u092e\u0938\u0942\u0930\u0940 \u0938\u094d\u0925\u093f\u0924 \u090f\u0932\u092c\u0940\u090f\u0938\u090f\u0928\u090f\u090f \u092e\u0947\u0902 2024 \u092c\u0948\u091a \u0915\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0941 \u0906\u0908\u090f\u090f\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u0902\u092c\u094b\u0927\u093f\u0924 \u0915\u093f\u092f\u093e",
