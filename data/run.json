      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2313283",
      "\u0921\u0940\u0921\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u0938 \u0928\u0947 \u0935\u093f\u092d\u093e\u0917\u0940\u092f \u0936\u093f\u0916\u0930 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u0947 \u092c\u093e\u0926 \u091c\u0932 \u091c\u0940\u0935\u0928 \u092e\u093f\u0936\u0928 2.0 \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u091c\u0932 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0915\u0941\u0936\u0932 \u0915\u093e\u0930\u094d\u092f\u092c\u0932 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0930\u093e\u091c\u094d\u092f\u094b\u0902 \u090f\u0935\u0902 \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0939\u0932\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2313285",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0928\u093e\u0930\u0915\u094b\u091f\u093f\u0915\u094d\u0938 \u092c\u094d\u092f\u0942\u0930\u094b \u0914\u0930 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0915\u0941\u092e\u093e\u0930\u0940\u091c \u0928\u0947 \u092e\u093e\u0926\u0915 \u092a\u0926\u093e\u0930\u094d\u0925\u094b\u0902 \u0915\u0940 \u0930\u094b\u0915\u0925\u093e\u092e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e, \u092f\u0941\u0935\u093e\u0913\u0902 \u0915\u0947 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0914\u0930 \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u094b \u0938\u0941\u0926\u0943\u0922\u093c \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0938\u092e\u091d\u094c\u0924\u093e \u091c\u094d\u091e\u093e\u092a\u0928 \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0915\u093f\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2313282",
