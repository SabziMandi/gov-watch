      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308002",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u0942\u0915\u094d\u0937\u094d\u092e, \u0932\u0918\u0941 \u090f\u0935\u0902 \u092e\u0927\u094d\u092f\u092e \u0909\u0926\u094d\u092f\u092e \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0938\u0941\u0936\u094d\u0930\u0940 \u0936\u094b\u092d\u093e \u0915\u0930\u0902\u0926\u0932\u093e\u091c\u0947 \u092c\u0947\u0902\u0917\u0932\u0941\u0930\u0941 \u0915\u0947 \u0926\u0947\u0935\u0928\u0939\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u0930\u0947\u0902\u0917\u0940",
