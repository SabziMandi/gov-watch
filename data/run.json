    "sample_added": [
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u0938\u094d\u0924\u094d\u0930 \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u0938\u093f\u0902\u0939 \u0928\u0947 \u091c\u0928\u092a\u0925 \u0938\u094d\u0925\u093f\u0924 \u2018\u0939\u0948\u0902\u0921\u0932\u0942\u092e \u0939\u093e\u091f: \u0926 \u0939\u0948\u0902\u0921\u0932\u0942\u092e \u090f\u0915\u094d\u0938\u092a\u0940\u0930\u093f\u092f\u0902\u0938 \u0938\u0947\u0902\u091f\u0930\u2019 \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299735",
      "\u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u093f\u0924\u094d\u0924 \u0914\u0930 \u0915\u0949\u0930\u092a\u094b\u0930\u0947\u091f \u0915\u093e\u0930\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u0940\u090f\u092e \u0907\u0902\u091f\u0930\u094d\u0928\u0936\u093f\u092a \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0941\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299736",
      "\u0915\u0949\u0930\u092a\u094b\u0930\u0947\u091f \u0915\u093e\u0930\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0907\u0902\u091f\u0930\u094d\u0928\u0936\u093f\u092a \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0924\u0939\u0924 \u092f\u0941\u0935\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0930\u094d\u0925\u0915 \u0907\u0902\u091f\u0930\u094d\u0928\u0936\u093f\u092a \u0915\u0947 \u0905\u0935\u0938\u0930 \u0938\u0943\u091c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u092e\u0941\u0916 \u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0915\u0902\u092a\u0928\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u092e\u094d\u092e\u093e\u0928\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u092a\u0940\u090f\u092e\u0906\u0908\u090f\u0938 \u0909\u0926\u094d\u092f\u094b\u0917 \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930\u094b\u0902 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299737",
      "\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u090f\u0935\u0902 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0905\u0915\u093e\u0926\u092e\u0940 \u0928\u0947 '\u0939\u0930 \u0918\u0930 \u0924\u093f\u0930\u0902\u0917\u093e \u0905\u092d\u093f\u092f\u093e\u0928' \u0915\u094b \u092c\u0921\u093c\u0947 \u0909\u0924\u094d\u0938\u093e\u0939 \u0914\u0930 \u0926\u0947\u0936\u092d\u0915\u094d\u0924\u093f \u0915\u0940 \u092d\u093e\u0935\u0928\u093e \u0915\u0947 \u0938\u093e\u0925 \u092e\u0928\u093e\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299733",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0928\u094d\u092f\u093e\u092f \u090f\u0935\u0902 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u0921\u0949. \u0935\u0940\u0930\u0947\u0902\u0926\u094d\u0930 \u0915\u0941\u092e\u093e\u0930 \u0928\u0947 \u0939\u093e\u0936\u093f\u092f\u0947 \u0915\u0947 \u0938\u092e\u0941\u0926\u093e\u092f\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0935\u0947\u0936\u0940 \u0935\u093f\u0915\u093e\u0938 \u0914\u0930 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927\u0924\u093e \u0926\u094b\u0939\u0930\u093e\u0908",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299738",
      "\u0936\u094d\u0930\u0940 \u092e\u0928\u094b\u0939\u0930 \u0932\u093e\u0932 \u0928\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0935\u094d\u092f\u093e\u092a\u0940 \u2018\u0939\u0930 \u0918\u0930 \u0924\u093f\u0930\u0902\u0917\u093e\u2019 \u0905\u092d\u093f\u092f\u093e\u0928 \u0915\u0947 \u0924\u0939\u0924 \u2018\u0939\u0930 \u0918\u0930 \u0924\u093f\u0930\u0902\u0917\u093e\u2019 \u0915\u093f\u092f\u094b\u0938\u094d\u0915 \u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299729",
      "\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0939\u094b\u092e\u094d\u092f\u094b\u092a\u0948\u0925\u0940 \u0906\u092f\u094b\u0917 \u0928\u0947 \u0939\u094b\u092e\u094d\u092f\u094b\u092a\u0948\u0925\u093f\u0915 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u094d\u092f \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u092a\u0926\u094d\u0927\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0928\u093f\u092f\u093e\u092e\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299734",
      "\u090f\u092e\u090f\u092e\u0921\u0940\u0906\u0930 \u0938\u0902\u0936\u094b\u0927\u0928 \u0938\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0916\u0928\u093f\u091c \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u0906\u090f\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299727",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0921\u0949. \u0935\u0940\u0930\u0947\u0902\u0926\u094d\u0930 \u0915\u0941\u092e\u093e\u0930 \u0928\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0935\u0930\u093f\u0937\u094d\u0920 \u0928\u093e\u0917\u0930\u093f\u0915 \u092a\u0930\u093f\u0937\u0926 \u0915\u0940 \u092a\u093e\u0902\u091a\u0935\u0940\u0902 \u092c\u0948\u0920\u0915 \u0915\u0940 \u0905\u0927\u094d\u092f\u0915\u094d\u0937\u0924\u093e \u0915\u0940; \u092c\u0941\u091c\u0941\u0930\u094d\u0917\u094b\u0902 \u0915\u0947 \u0915\u0932\u094d\u092f\u093e\u0923, \u0909\u0928\u0915\u0947 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0926\u0947\u0916\u092d\u093e\u0932 \u0914\u0930 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094d\u0930\u092e\u0941\u0916 \u092a\u0939\u0932\u094b\u0902 \u0935 \u0928\u0940\u0924\u093f\u0917\u0924 \u092e\u0941\u0926\u094d\u0926\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299728",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923, \u0935\u0928 \u0914\u0930 \u091c\u0932\u0935\u093e\u092f\u0941 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0917\u0940\u0924 \u2018\u0935\u0902\u0926\u0947 \u092e\u093e\u0924\u0930\u092e\u2019 \u0915\u0947 \u0938\u093e\u092e\u0942\u0939\u093f\u0915 \u0917\u093e\u092f\u0928 \u0915\u0947 \u0938\u093e\u0925 \u2018\u0939\u0930 \u0918\u0930 \u0924\u093f\u0930\u0902\u0917\u093e 2026\u2019 \u0905\u092d\u093f\u092f\u093e\u0928 \u092e\u0928\u093e\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2299730",
