      "\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u093e\u0928\u0935\u093e\u0927\u093f\u0915\u093e\u0930 \u0906\u092f\u094b\u0917 (\u090f\u0928\u090f\u091a\u0906\u0930\u0938\u0940) \u0928\u0947 \u0939\u0930\u093f\u092f\u093e\u0923\u093e \u092e\u0947\u0902 \u0905\u0902\u092c\u093e\u0932\u093e \u091c\u093f\u0932\u0947 \u0915\u0947 \u0936\u093e\u0939\u091c\u093e\u0926\u092a\u0941\u0930 \u092e\u0947\u0902 \u0926\u0942\u0937\u093f\u0924 \u092a\u0947\u092f\u091c\u0932 \u0915\u0947 \u0938\u0947\u0935\u0928 \u0938\u0947 \u092a\u0940\u0932\u093f\u092f\u093e \u0915\u0947 \u0915\u093e\u0930\u0923 \u090f\u0915 \u0932\u0921\u093c\u0915\u0940 \u0915\u0940 \u092e\u0943\u0924\u094d\u092f\u0941 \u0915\u093e \u0938\u094d\u0935\u0924\u0903 \u0938\u0902\u091c\u094d\u091e\u093e\u0928 \u0932\u093f\u092f\u093e \u0939\u0948",
      "\u0915\u0930\u094d\u0928\u093e\u091f\u0915 \u092e\u0947\u0902 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u091c\u0928\u091c\u093e\u0924\u093f \u0915\u093e \u0935\u093f\u0915\u093e\u0938",
      "\u0908\u090f\u092e\u0906\u0930\u090f\u0938 \u0915\u0947 \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u092a\u0930\u093f\u0923\u093e\u092e",
      "\u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932 \u0915\u0947 \u0905\u0932\u0940\u092a\u0941\u0930\u0926\u094d\u0935\u093e\u0930 \u092e\u0947\u0902 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u091c\u0928\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f \u092f\u094b\u091c\u0928\u093e\u090f\u0902",
      "\u0930\u0915\u094d\u0937\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u094d\u0930\u093e\u0926\u0947\u0936\u093f\u0915 \u0938\u0947\u0928\u093e \u0938\u0902\u092c\u0902\u0927\u0940 \u0930\u0915\u094d\u0937\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0940 \u0938\u0902\u0938\u0926\u0940\u092f \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u092e\u093f\u0924\u093f \u0915\u0940 \u092c\u0948\u0920\u0915 \u0915\u0940 \u0905\u0927\u094d\u092f\u0915\u094d\u0937\u0924\u093e \u0915\u0940",
      "\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u090f\u091c\u0947\u0902\u0938\u093f\u092f\u093e\u0902",
      "\u091c\u0928\u091c\u093e\u0924\u0940\u092f \u092d\u0942\u092e\u093f \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u0939\u092e\u0924\u093f",
      "\u091c\u0928\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091b\u093e\u0924\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0932\u093e\u092d \u0905\u0902\u0924\u0930\u0923",
      "\u0905\u092a\u094d\u0930\u0948\u0932-\u091c\u0941\u0932\u093e\u0908 2026: \u0907\u0938\u094d\u092a\u093e\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0935\u0943\u0926\u094d\u0927\u093f \u0915\u093e \u0930\u0941\u091d\u093e\u0928",
      "\u0921\u0940\u090f\u091c\u0947\u091c\u0940\u092f\u0942\u090f \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0935\u093f\u0936\u0947\u0937 \u092a\u0939\u0932\u0947\u0902",
      "\u0915\u0947\u0928-\u092c\u0947\u0924\u0935\u093e \u0932\u093f\u0902\u0915 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0938\u0947 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u091c\u0928\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u0938",
      "\u0935\u0928 \u0917\u0941\u0930\u094d\u091c\u0930 \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u0938\u092e\u0941\u0926\u093e\u092f \u0915\u093e \u092e\u094c\u0938\u092e\u0940 \u092a\u094d\u0930\u0935\u093e\u0938\u0928",
      "\u0915\u094b\u092f\u0932\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u092e\u093f\u0924\u093f \u0928\u0947 \u0935\u093e\u0923\u093f\u091c\u094d\u092f\u093f\u0915 \u0915\u094b\u092f\u0932\u093e \u0916\u0928\u0928 \u0938\u0941\u0927\u093e\u0930\u094b\u0902 \u0914\u0930 \u0928\u093f\u091c\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u0947 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0940",
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u0943\u0925\u094d\u0935\u0940 \u0915\u094b \u0938\u092e\u0938\u094d\u0924 \u091c\u0940\u0935\u0928 \u0915\u0940 \u092a\u093e\u0932\u0928-\u092a\u094b\u0937\u0923 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u092e\u093e\u0924\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u0902\u0938\u094d\u0915\u0943\u0924 \u0938\u0941\u092d\u093e\u0937\u093f\u0924\u092e\u094d \u0915\u094b \u0938\u093e\u091d\u093e \u0915\u093f\u092f\u093e",
      "\u0936\u094d\u0930\u0940 \u091f\u0947\u0921 \u0938\u093e\u0930\u0902\u0921\u094b\u0938 \u0928\u0947 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940"
    ],
