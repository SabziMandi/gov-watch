      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2313732",
      "\u0926\u0942\u0930\u0938\u0902\u091a\u093e\u0930 \u0935\u093f\u092d\u093e\u0917 \u0928\u0947 \u092c\u0947\u0902\u0917\u0932\u0941\u0930\u0941 \u092e\u0947\u0902 \u0926\u0942\u0930\u0938\u0902\u091a\u093e\u0930 \u0935\u093f\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0935\u0947\u0936, \u0928\u0935\u093e\u091a\u093e\u0930 \u0914\u0930 \u0918\u0930\u0947\u0932\u0942 \u0935\u093f\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0924\u0940\u0938\u0930\u0947 \u0928\u093f\u0935\u0947\u0936\u0915 \u0917\u094b\u0932\u092e\u0947\u091c \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2313728",
