      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u090f\u0936\u093f\u092f\u093e\u0908 \u0916\u0947\u0932 2026 \u092e\u0947\u0902 \u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0932 \u0915\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0940 \u0938\u0930\u093e\u0939\u0928\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318958",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0938\u0930\u094d\u092c\u093e\u0928\u0902\u0926 \u0938\u094b\u0928\u094b\u0935\u093e\u0932 \u0921\u093f\u092c\u094d\u0930\u0942\u0917\u0922\u093c \u0938\u0947 \u092a\u0939\u0932\u0940 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u093e\u0932\u0935\u093e\u0939\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u0939\u0930\u0940 \u091d\u0902\u0921\u0940 \u0926\u093f\u0916\u093e\u090f\u0902\u0917\u0947",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318953",
      "\u0921\u0940\u0906\u0930\u0906\u0908 \u0928\u0947 \u092e\u093e\u0926\u0915 \u092a\u0926\u093e\u0930\u094d\u0925\u094b\u0902 \u0915\u0940 \u0924\u0938\u094d\u0915\u0930\u0940 \u092a\u0930 \u0928\u0915\u0947\u0932 \u0915\u0938\u0928\u0947 \u0915\u093e \u0905\u092d\u093f\u092f\u093e\u0928 \u0924\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0924\u0940\u0928 \u0905\u092d\u093f\u092f\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 7 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u090f\u092e\u094d\u092b\u0947\u091f\u0947\u092e\u093f\u0928, 5 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u0915\u094b\u0915\u0940\u0928 \u0914\u0930 3.5 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u0939\u0947\u0930\u094b\u0907\u0928 \u091c\u092c\u094d\u0924 \u0915\u0940; 5 \u0932\u094b\u0917 \u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318957",
      "\u0915\u092a\u093e\u0938 \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u0938\u0936\u0915\u094d\u0924 \u092c\u0928\u093e\u0928\u0947, \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u093f\u0924\u093e \u092e\u0947\u0902 \u0935\u0943\u0926\u094d\u0927\u093f \u0915\u0930\u0928\u0947 \u0914\u0930 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0915\u092a\u093e\u0938 \u092e\u0942\u0932\u094d\u092f \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0947 \u0915\u093f\u090f \u0917\u090f \u0938\u0941\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092e\u0947\u0902 \u0939\u094b\u0902\u0917\u0947",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318933",
      "\u092d\u093e\u0930\u0924 \u0915\u093e \u0909\u092d\u0930\u0924\u093e \u0938\u0941\u092a\u0930\u0915\u0902\u092a\u094d\u092f\u0942\u091f\u093f\u0902\u0917 \u092a\u0930\u093f\u0924\u0902\u0924\u094d\u0930",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318910",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0921\u0949. \u091c\u093f\u0924\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0928\u0947 \u091c\u092e\u094d\u092e\u0942 \u0915\u0947 \u0926\u093f\u0932\u094d\u0932\u0940-\u0938\u094d\u0925\u093f\u0924 \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u0921\u093f\u0915\u0932 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092d\u094b\u091c \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e; \u091c\u0940\u090f\u092e\u0938\u0940 \u091c\u092e\u094d\u092e\u0942 \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u092b\u0947\u0938\u0930 \u0915\u0947 \u0924\u094c\u0930 \u092a\u0930 \u092c\u093f\u0924\u093e\u090f \u0926\u093f\u0928\u094b\u0902 \u0915\u094b \u092f\u093e\u0926 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2318931",
