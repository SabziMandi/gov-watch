      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2334789",
      "\u0928\u090f \u090f\u092e\u094d\u0938 \u092e\u0947\u0902 2021-22 \u0938\u0947 \u0905\u092c \u0924\u0915 6 \u0915\u0930\u094b\u0921\u093c \u0938\u0947 \u0905\u0927\u093f\u0915 \u0913\u092a\u0940\u0921\u0940 \u092a\u0930\u093e\u092e\u0930\u094d\u0936, \u0926\u0947\u0936\u092d\u0930 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u0924\u0943\u0924\u0940\u092f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0940 \u092a\u0939\u0941\u0902\u091a \u0915\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930",
