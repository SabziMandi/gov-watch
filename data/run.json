    "sample_added": [
      "\u092d\u093e\u0930\u0924, \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092e\u0947\u0902 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u0947 \u0928\u0947\u0924\u0943\u0924\u094d\u0935 \u0935\u093e\u0932\u0947 \u0909\u0926\u094d\u092f\u092e\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092e\u094c\u0915\u0947 \u092c\u0922\u093c\u093e\u0928\u0947 \u0939\u0947\u0924\u0941 \u092c\u094d\u0930\u093f\u0915\u094d\u0938 \u0938\u0939\u092f\u094b\u0917\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u0915\u093e\u092e \u0915\u0930\u0947\u0917\u093e: \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u093e\u0923\u093f\u091c\u094d\u092f \u0914\u0930 \u0909\u0926\u094d\u092f\u094b\u0917 \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u092a\u0940\u092f\u0942\u0937 \u0917\u094b\u092f\u0932",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308573",
      "\u0907\u0938\u094d\u092a\u093e\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u2018\u0907\u0928\u094b\u092a\u094d\u0930\u094b\u092e \u0907\u0902\u0921\u093f\u092f\u093e 2026\u2019 \u092e\u0947\u0902 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0907\u0938\u094d\u092a\u093e\u0924 \u0938\u0902\u092c\u0902\u0927\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308571",
      "\u0921\u0940\u0906\u0930\u0906\u0908 \u0928\u0947 \u0926\u094b \u0924\u0947\u0902\u0926\u0941\u090f \u0915\u0940 \u0916\u093e\u0932; 180 \u091c\u0940\u0935\u093f\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u0924\u093e\u0930\u093e \u0915\u091b\u0941\u090f; 12 \u091c\u0940\u0935\u093f\u0924 \u091f\u094b\u0915\u0947 \u0917\u0947\u0915\u094b; \u0932\u0917\u092d\u0917 24 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u092a\u0948\u0902\u0917\u094b\u0932\u093f\u0928 \u0915\u0947 \u0936\u0932\u094d\u0915 \u0914\u0930 500 \u0917\u094d\u0930\u093e\u092e \u092c\u093e\u0918 \u0915\u0940 \u0939\u0921\u094d\u0921\u093f\u092f\u093e\u0902 \u091c\u092c\u094d\u0924 \u0915\u0940\u0902",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308572",
      "\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 '\u092f\u0941\u0917\u0947 \u092f\u0941\u0917\u0940\u0928 \u092d\u093e\u0930\u0924 \u092e\u094d\u092f\u0942\u091c\u093f\u092f\u092e' (\u0935\u093e\u0908\u0935\u093e\u0908\u092c\u0940\u090f\u092e) \u0915\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u0947 \u0924\u0939\u0924 \u0926\u094b \u092c\u0921\u093c\u0947 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u094b\u0902 - '\u0936\u093f\u0932\u094d\u092a\u0915\u093e\u0930 \u0938\u092e\u093e\u0917\u092e' (2-3 \u0938\u093f\u0924\u0902\u092c\u0930 2026) \u0914\u0930 '\u0935\u0947\u0902\u0921\u0930 \u0935\u093f\u0915\u093e\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e' (7-8 \u0938\u093f\u0924\u0902\u092c\u0930 2026) - \u0915\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308574",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u091c\u093f\u0924\u093f\u0928 \u092a\u094d\u0930\u0938\u093e\u0926 \u0928\u0947 \u092a\u0940\u0932\u0940\u092d\u0940\u0924 \u092e\u0947\u0902 \u092c\u0940\u0908\u0921\u0940\u090f\u092b \u092c\u093e\u0938\u092e\u0924\u0940 \u0914\u0930 \u091c\u0948\u0935\u093f\u0915 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u0940 \u0906\u0927\u093e\u0930\u0936\u093f\u0932\u093e \u0930\u0916\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308570",
      "\u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0915\u0943\u0937\u093f \u0914\u0930 \u0935\u093e\u0928\u093f\u0915\u0940 \u092a\u0930 9\u0935\u0940\u0902 \u0906\u0938\u093f\u092f\u093e\u0928-\u092d\u093e\u0930\u0924 \u092e\u0902\u0924\u094d\u0930\u093f\u0938\u094d\u0924\u0930\u0940\u092f \u092c\u0948\u0920\u0915 \u0914\u0930 10\u0935\u0940\u0902 \u0906\u0938\u093f\u092f\u093e\u0928-\u092d\u093e\u0930\u0924 \u0915\u0943\u0937\u093f \u0915\u093e\u0930\u094d\u092f \u0938\u092e\u0942\u0939 \u0915\u0940 \u092c\u0948\u0920\u0915 \u0906\u092f\u094b\u091c\u093f\u0924",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308569"
    ],
    "sample_removed": [
      "\u0930\u0947\u0932 \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0935\u0940. \u0938\u094b\u092e\u0928\u094d\u0928\u093e \u0928\u0947 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0902\u0921\u0932 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0938\u0941\u0930\u0915\u094d\u0937\u093e, \u0938\u0902\u091a\u093e\u0932\u0928, \u0938\u092e\u092f \u0915\u0940 \u092a\u093e\u092c\u0902\u0926\u0940 \u0914\u0930 \u091c\u0928 \u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308450",
      "\u092d\u093e\u0930\u0924 \u0915\u094b \u0928\u0936\u093e\u092e\u0941\u0915\u094d\u0924 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0905\u092d\u093f\u092f\u093e\u0928 \u092e\u0947\u0902 \u091a\u093e\u0930 \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0938\u0902\u0917\u0920\u0928 - \u0905\u0927\u094d\u092f\u093e\u0924\u094d\u092e \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0938\u0924\u094d\u0938\u0902\u0917 \u0915\u0947\u0902\u0926\u094d\u0930, \u091a\u093f\u0928\u094d\u092e\u092f \u092e\u093f\u0936\u0928, \u0926\u093f\u0935\u094d\u092f \u091c\u094d\u092f\u094b\u0924\u093f \u091c\u093e\u0917\u0943\u0924\u093f \u0938\u0902\u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0939\u0930\u0947 \u0915\u0943\u0937\u094d\u0923\u093e \u0906\u0902\u0926\u094b\u0932\u0928 - \u0936\u093e\u092e\u093f\u0932; \u0938\u091a\u093f\u0935 \u0938\u0941\u0927\u093e\u0902\u0936 \u092a\u0902\u0924 \u0915\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0928\u094d\u092f\u093e\u092f \u0914\u0930 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0947 \u0938\u093e\u0925 \u0938\u092e\u091d\u094c\u0924\u093e \u091c\u094d\u091e\u093e\u092a\u0928 \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308479",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092b\u094d\u0932\u094b\u0930\u094b\u0938\u093f\u0938 \u0926\u093f\u0935\u0938 \u092a\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092c\u0939\u0941-\u0939\u093f\u0924\u0927\u093e\u0930\u0915 \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308383",
      "\u092c\u0940\u091c \u092e\u093e\u092b\u093f\u092f\u093e\u0913\u0902 \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u0915\u0921\u093c\u0947 \u2018\u0938\u0940\u0921 \u090f\u0915\u094d\u091f\u2019 \u0932\u093e\u0928\u0947 \u0915\u094b \u0932\u0947\u0915\u0930 10 \u0938\u093f\u0924\u0902\u092c\u0930 \u0915\u094b \u0926\u0947\u0936\u092d\u0930 \u0915\u0947 \u0915\u093f\u0938\u093e\u0928 \u0928\u0947\u0924\u093e\u0913\u0902 \u0938\u0902\u0917 \u0936\u094d\u0930\u0940 \u0936\u093f\u0935\u0930\u093e\u091c \u0938\u093f\u0902\u0939 \u091a\u094c\u0939\u093e\u0928 \u0915\u0930\u0947\u0902\u0917\u0947 \u092c\u0948\u0920\u0915",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308337",
      "\u091c\u0948\u0935\u093f\u0915 \u0905\u0923\u0941\u0913\u0902 \u0915\u093e \u0938\u094d\u0935-\u0938\u0902\u092f\u094b\u091c\u0928 \u0939\u0930\u093f\u0924 \u0939\u093e\u0907\u0921\u094d\u0930\u094b\u091c\u0928 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u0915\u093e \u0928\u092f\u093e \u092e\u093e\u0930\u094d\u0917 \u0916\u094b\u0932\u0924\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308400",
      "\u0939\u093f\u092e\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u0947 \u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0938\u0941\u0916\u0935\u093f\u0902\u0926\u0930 \u0938\u093f\u0902\u0939 \u0938\u0941\u0915\u094d\u0916\u0942 \u0928\u0947 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0921\u0949. \u091c\u093f\u0924\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940; \u092e\u094c\u0938\u092e \u0915\u0940 \u092a\u0942\u0930\u094d\u0935-\u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940, \u0932\u0948\u0935\u0947\u0902\u0921\u0930 \u0915\u0940 \u0916\u0947\u0924\u0940 \u0914\u0930 \u090f\u0938\u094d\u200d\u091f\u094d\u0930\u094b-\u091f\u0942\u0930\u093f\u091c\u094d\u200d\u092e \u092a\u0930 \u091a\u0930\u094d\u091a\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2308375"
