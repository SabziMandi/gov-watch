      "\u0938\u0947\u092e\u0940\u0915\u0949\u0928 2.0 \u092e\u0947\u0902 \u0921\u093f\u091c\u093e\u0907\u0928, \u0907\u0915\u094d\u0935\u093f\u092a\u092e\u0947\u0902\u091f, \u092b\u0948\u092c, \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u092a\u0948\u0915\u0947\u091c\u093f\u0902\u0917, \u0906\u0930\u090f\u0902\u0921\u0921\u0940 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u092d\u093e \u0935\u093f\u0915\u093e\u0938 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u0947\u092e\u0940\u0915\u0902\u0921\u0915\u094d\u091f\u0930 \u0907\u0915\u094b\u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b \u092e\u091c\u092c\u0942\u0924\u0940 \u092e\u093f\u0932\u0947\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311708",
      "43\u0935\u093e\u0902 \u092d\u093e\u0930\u0924\u0940\u092f \u0924\u091f\u0930\u0915\u094d\u0937\u0915 \u0915\u092e\u093e\u0902\u0921\u0930 \u0938\u092e\u094d\u092e\u0947\u0932\u0928: \u0930\u0915\u094d\u0937\u093e \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0939\u094b \u0930\u0939\u0947 \u0924\u0915\u0928\u0940\u0915\u0940 \u0935\u093f\u0915\u093e\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0924\u093e\u0932\u092e\u0947\u0932 \u092c\u093f\u0920\u093e\u0915\u0930 \u0909\u092d\u0930\u0924\u0940 \u0938\u092e\u0941\u0926\u094d\u0930\u0940 \u091a\u0941\u0928\u094c\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0930\u0939\u0928\u0947 \u0915\u093e \u0906\u0939\u094d\u0935\u093e\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311666",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0930\u0915\u094d\u0937\u093e \u0916\u0921\u0938\u0947 \u0928\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932 \u092e\u0947\u0902 \u0916\u0947\u0932 \u0935\u093f\u0915\u093e\u0938 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0940; \u091c\u092e\u0940\u0928\u0940 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0916\u0947\u0932\u094b\u0902 \u0914\u0930 \u0916\u093f\u0932\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u0947\u0939\u0924\u0930 \u0930\u093e\u0938\u094d\u0924\u0947 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u093e\u0908 \u0938\u0947 \u0938\u0939\u092f\u094b\u0917 \u0915\u093e \u092d\u0930\u094b\u0938\u093e \u0926\u093f\u0932\u093e\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311662",
      "\u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091c\u094d\u091e\u093e\u0928 \u092a\u0930 \u092c\u093f\u092e\u094d\u0938\u091f\u0947\u0915 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u093e \u0917\u094b\u0935\u093e \u092e\u0947\u0902 \u0938\u092e\u093e\u092a\u0928",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2311595",
