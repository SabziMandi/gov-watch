      "\u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0942\u091a\u0928\u093e \u0938\u0947\u0935\u093e \u0914\u0930 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0941 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0928\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301205",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0928\u0947 \u092c\u093f\u0939\u093e\u0930 \u092e\u0947\u0902 \u090f\u0928\u090f\u091a-22 \u0915\u0947 \u092e\u0941\u091c\u092b\u094d\u092b\u0930\u092a\u0941\u0930-\u0938\u0940\u0924\u093e\u092e\u0922\u093c\u0940-\u0938\u094b\u0928\u092c\u0930\u0938\u093e \u0916\u0902\u0921 \u0915\u094b \u091a\u093e\u0930- \u0932\u0947\u0928 \u092e\u093e\u0928\u0915 \u092e\u0947\u0902 \u0909\u0928\u094d\u200d\u0928\u092f\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094d\u200d\u0935\u0940\u0915\u0943\u0924\u093f \u0926\u0940; \u0907\u0938 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0915\u093e \u0935\u093f\u0915\u093e\u0938 \u0939\u093e\u0907\u092c\u094d\u0930\u093f\u0921 \u090f\u0928\u094d\u092f\u0941\u0907\u091f\u0940 \u092e\u094b\u0921 \u0924\u0939\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0907\u0938\u0915\u0940 \u0915\u0941\u0932 \u092a\u0942\u0902\u091c\u0940 \u0932\u093e\u0917\u0924 3590.73 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947 \u0939\u094b\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301196",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0928\u0947 \u092c\u093f\u0939\u093e\u0930 \u092e\u0947\u0902 \u090f\u0928\u090f\u091a-22 \u0915\u0947 \u092e\u0941\u091c\u092b\u094d\u092b\u0930\u092a\u0941\u0930-\u0938\u0940\u0924\u093e\u092e\u0922\u093c\u0940-\u0938\u094b\u0928\u092c\u0930\u0938\u093e \u0916\u0902\u0921 \u0915\u094b \u091a\u093e\u0930- \u0932\u0947\u0928 \u092e\u093e\u0928\u0915 \u092e\u0947\u0902 \u0909\u0928\u094d\u200d\u0928\u092f\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094d\u200d\u0935\u0940\u0915\u0943\u0924\u093f \u0926\u0940; \u0907\u0938 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0915\u093e \u0935\u093f\u0915\u093e\u0938 \u0939\u093e\u0907\u092c\u094d\u0930\u093f\u0921 \u090f\u0928\u094d\u092f\u0941\u0907\u091f\u0940 \u092e\u094b\u0921 \u0924\u0939\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0907\u0938\u0915\u0940 \u0915\u0941\u0932 \u092a\u0942\u0902\u091c\u0940 \u0932\u093e\u0917\u0924 3590.73 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947 \u0939\u094b\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301195",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0928\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932, \u0913\u0921\u093f\u0936\u093e, \u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u0914\u0930 \u0906\u0902\u0927\u094d\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u0947 \u0906\u0920 \u091c\u093f\u0932\u094b\u0902 \u0915\u094b \u0915\u0935\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u091a\u093e\u0930 \u092e\u0932\u094d\u091f\u0940\u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0940, \u091c\u093f\u0938\u0938\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0930\u0947\u0932 \u0915\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 410 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0915\u0940 \u0935\u0943\u0926\u094d\u0927\u093f \u0939\u094b\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301171",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0928\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932, \u0913\u0921\u093f\u0936\u093e, \u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u0914\u0930 \u0906\u0902\u0927\u094d\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u0947 \u0906\u0920 \u091c\u093f\u0932\u094b\u0902 \u0915\u094b \u0915\u0935\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u091a\u093e\u0930 \u092e\u0932\u094d\u091f\u0940\u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0940, \u091c\u093f\u0938\u0938\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0930\u0947\u0932 \u0915\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 410 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0915\u0940 \u0935\u0943\u0926\u094d\u0927\u093f \u0939\u094b\u0917\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2301170"
    ],
