    "type": "change",
    "added": 26,
    "removed": 26,
    "sample_added": [
      "\u092e\u0902\u0924\u094d\u0930\u093f\u092e\u0902\u0921\u0932 \u0915\u0940 \u092e\u0902\u091c\u0942\u0930\u0940 \u0915\u0947 \u092c\u093e\u0926 \u092d\u093e\u0930\u0924\u0940\u092f \u0921\u093e\u0915 2,632 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947 \u0915\u0947 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u092a\u0930\u093f\u0935\u094d\u092f\u092f \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u0924\u0947\u091c \u0915\u0930\u0928\u0947 \u091c\u093e \u0930\u0939\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342300",
      "\u0906\u0930\u094d\u092f\u0928 \u0915\u0947 \u0928\u091c\u0930\u093f\u090f \u0938\u0947: \u0936\u094d\u0930\u0940\u0939\u0930\u093f \u0939\u0930\u093f\u0926\u093e\u0938 \u0928\u0947 \u092e\u0949\u0915\u094d\u092f\u0942\u092e\u0947\u0902\u091f\u094d\u0930\u0940 \u0936\u0948\u0932\u0940 \u092e\u0947\u0902 \u0915\u0939\u093e\u0928\u0940 \u0915\u0939\u0928\u0947, \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u094d\u0930\u092d\u093e\u0935\u094b\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092b\u0940\u091a\u0930 \u092b\u093f\u0932\u094d\u092e \u2018\u0905\u091c\u092f\u0928\u094d\u0924\u0947 \u092e\u0930\u0923\u092e\u094d: \u0913\u0930\u0941 \u0915\u0947\u0938 \u0938\u094d\u091f\u0921\u0940\u2019 \u0915\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342250",
      "\u092d\u093e\u0930\u0924 \u0914\u0930 \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0905\u0930\u092c \u0905\u092e\u0940\u0930\u093e\u0924 \u0905\u092c\u0942 \u0927\u093e\u092c\u0940 \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 14\u0935\u0940\u0902 \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u0915\u094d\u0937\u093e \u0938\u0939\u092f\u094b\u0917 \u0938\u092e\u093f\u0924\u093f \u0915\u0940 \u092c\u0948\u0920\u0915 \u092e\u0947\u0902 \u0905\u0917\u0932\u0940 \u092a\u0940\u0922\u093c\u0940 \u0915\u0947 \u0930\u0915\u094d\u0937\u093e \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u093e\u0938 \u090f\u0935\u0902 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u092e\u0947\u0902 \u0924\u0947\u091c\u0940 \u0932\u093e\u0928\u0947 \u092a\u0930 \u0938\u0939\u092e\u0924 \u0939\u0941\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342271",
      "\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0947\u0935\u093e\u090f\u0902 \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u092a\u0947\u0902\u0936\u0928 \u0938\u0941\u0927\u093e\u0930 \u092a\u094d\u0930\u092d\u093e\u0917 \u0928\u0947 \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0938\u0941\u0927\u093e\u0930 \u090f\u0935\u0902 \u0932\u094b\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u0935\u093f\u092d\u093e\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0915\u094d\u091f\u0942\u092c\u0930 2026 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0930\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0928\u093f\u0935\u093e\u0930\u0923 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u090f\u0935\u0902 \u0938\u0942\u091a\u0915\u093e\u0902\u0915 (\u091c\u0940\u0906\u0930\u090f\u0906\u0908) \u0915\u0947 \u0938\u092e\u0942\u0939 \u092c\u0940 \u0936\u094d\u0930\u0947\u0923\u0940 \u092e\u0947\u0902 \u0936\u0940\u0930\u094d\u0937 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u092f\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342252",
      "\u0921\u0949. \u0905\u0902\u092c\u0947\u0921\u0915\u0930 \u092b\u093e\u0909\u0902\u0921\u0947\u0936\u0928 \u0928\u0947 \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0926\u093f\u0935\u0938 2026 \u092e\u0928\u093e\u092f\u093e; \u0938\u0902\u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u092e\u0942\u0932\u094d\u092f\u094b\u0902, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0928\u094d\u092f\u093e\u092f \u0914\u0930 \u0938\u092e\u093e\u0935\u0947\u0936\u0940 \u0932\u094b\u0915\u0924\u0902\u0924\u094d\u0930 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927\u0924\u093e \u0915\u094b \u092a\u0941\u0928\u0903 \u0926\u094b\u0939\u0930\u093e\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342281",
      "\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e\u0928\u0940 \u0915\u093e \u092e\u093e\u0928\u0935\u0940\u092f \u091a\u0930\u093f\u0924\u094d\u0930 \u090f\u0935\u0902 \u0917\u093e\u0902\u0927\u0940\u0935\u093e\u0926\u0940 \u0906\u0926\u0930\u094d\u0936\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u093e\u0935 \u0938\u092c\u0938\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u093f\u091a\u093e\u0930: \u0906\u0908\u0938\u0940\u090f\u092b\u091f\u0940-\u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0917\u093e\u0902\u0927\u0940 \u092a\u0926\u0915 \u091c\u0942\u0930\u0940 \u0938\u0926\u0938\u094d\u092f \u092e\u0928\u094b\u091c \u0915\u0926\u092e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342231",
      "\u0911\u0938\u094d\u0915\u0930 \u0915\u094b \u0938\u092e\u091d\u0928\u093e: 57\u0935\u0947\u0902 \u0906\u0908\u090f\u092b\u090f\u092b\u0906\u0908 \u092e\u0947\u0902 \u0928\u0924\u093e\u0932\u0940 \u0935\u0947\u0921 \u0928\u0947 \u092b\u093f\u0932\u094d\u092e \u0928\u093f\u0930\u094d\u092e\u093e\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u092c\u092e\u093f\u0936\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0905\u0935\u0938\u0930\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342246",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u093f\u0924\u094d\u0924 \u090f\u0935\u0902 \u0915\u0949\u0930\u092a\u094b\u0930\u0947\u091f \u0915\u093e\u0930\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940\u092e\u0924\u0940 \u0928\u093f\u0930\u094d\u092e\u0932\u093e \u0938\u0940\u0924\u093e\u0930\u092e\u0923 \u0928\u0947 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092c\u091c\u091f 2027-28 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u093e\u092a\u0915 \u092c\u091c\u091f-\u092a\u0942\u0930\u094d\u0935 \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u0938\u0902\u092a\u0928\u094d\u0928 \u0915\u093f\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342267",
      "\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u093e \u0938\u094d\u092e\u093e\u0930\u094d\u091f\u092b\u094b\u0928 \u0906\u092a\u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948? \u0906\u0908\u090f\u092b\u090f\u092b\u0906\u0908 2026 \u092e\u0947\u0902 \u0924\u092e\u093f\u0932 \u0925\u094d\u0930\u093f\u0932\u0930 '\u0938\u094d\u0915\u094d\u0930\u0949\u0932' \u0928\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u0932\u0947\u0915\u0930 \u090f\u0915 \u0928\u0908 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0940 \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342241",
      "\u092a\u0947\u092f\u091c\u0932 \u090f\u0935\u0902 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0935\u093f\u092d\u093e\u0917, \u091c\u0932 \u0936\u0915\u094d\u0924\u093f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0906\u0917\u0930\u093e \u092e\u0947\u0902 \u0926\u0942\u0938\u0930\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342260",
      "\u092d\u093e\u0930\u0924\u0940\u092f \u092a\u0941\u0930\u093e\u0924\u0924\u094d\u0935 \u0938\u0930\u094d\u0935\u0947\u0915\u094d\u0937\u0923 (\u090f\u090f\u0938\u0906\u0908) \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u093e\u091c\u094d\u092f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u0928\u0940\u0926\u0930\u0932\u0948\u0902\u0921 \u0938\u0947 \u0935\u093e\u092a\u0938 \u0932\u093e\u0908 \u0917\u0908\u0902 \u0924\u0940\u0928 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u093e\u0932\u0940\u0928 \u0935\u0938\u094d\u0924\u0941\u0913\u0902 \u0915\u094b \u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u092a\u0941\u0932\u093f\u0938 \u0915\u094b \u0938\u094c\u0902\u092a\u093e \u0917\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342235",
      "\u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u092c\u0948\u0902\u0915 (\u092a\u0940\u090f\u0938\u092c\u0940) \u0935\u093f\u0935\u0947\u0915\u092a\u0942\u0930\u094d\u0923 \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u092a\u094d\u0930\u0925\u093e\u0913\u0902 \u0914\u0930 \u092e\u091c\u092c\u0942\u0924 \u0905\u0902\u0921\u0930\u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u0915\u094d\u0937\u092e\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0914\u0930 \u092d\u0940 \u092e\u091c\u092c\u0942\u0924 \u0939\u094b \u0930\u0939\u0947 \u0939\u0948\u0902",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342232",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u093f\u0924\u093f\u0928 \u0917\u0921\u0915\u0930\u0940 \u0928\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932 \u0915\u0947 \u0932\u093f\u090f \u20b975,000 \u0915\u0930\u094b\u0921\u093c \u0915\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0930\u093e\u091c\u092e\u093e\u0930\u094d\u0917 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0915\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342234"
    ],
    "sample_removed": [
      "\u092d\u093e\u0930\u0924 \u0915\u093e \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0932\u094b\u0915\u0924\u0902\u0924\u094d\u0930, \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u090f\u0915\u0924\u093e \u0914\u0930 \u0907\u0938\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u0940 \u0906\u0927\u093e\u0930\u0936\u093f\u0932\u093e \u0939\u0948: \u0932\u094b\u0915 \u0938\u092d\u093e \u0905\u0927\u094d\u092f\u0915\u094d\u0937",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342084",
      "45\u0935\u0947\u0902 \u092d\u093e\u0930\u0924 \u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092e\u0947\u0932\u093e 2026 \u092e\u0947\u0902 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0928\u094d\u092f\u093e\u092f \u0914\u0930 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0947 \u092e\u0902\u0921\u092a \u0928\u0947 25 \u0928\u0935\u0902\u092c\u0930 \u0924\u0915 1.81 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0940 \u092c\u093f\u0915\u094d\u0930\u0940 \u0915\u093e \u0906\u0902\u0915\u0921\u093c\u093e \u092a\u093e\u0930 \u0915\u093f\u092f\u093e; \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0947 \u0915\u093e\u0930\u0940\u0917\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u091c\u0940\u0935\u093f\u0915\u093e \u0915\u0947 \u0905\u0935\u0938\u0930 \u092c\u0922\u093c\u0947 \u0939\u0948\u0902",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342166",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u091a\u093f\u0935 \u0938\u0941\u0936\u094d\u0930\u0940 \u092a\u0941\u0923\u094d\u092f \u0938\u0932\u093f\u0932\u093e \u0936\u094d\u0930\u0940\u0935\u093e\u0938\u094d\u0924\u0935 \u0928\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0916\u093e\u0926\u094d\u092f \u092a\u0926\u093e\u0930\u094d\u0925 \u0914\u0930 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u0926\u0935\u093e\u090f\u0902 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0930\u093e\u091c\u094d\u092f \u0938\u094d\u0924\u0930 \u092a\u0930 \u0928\u093f\u092f\u093e\u092e\u0915 \u0915\u094d\u0937\u092e\u0924\u093e \u092e\u091c\u092c\u0942\u0924 \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u0906\u0939\u094d\u0935\u093e\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342132",
      "\u0938\u0940\u090f\u0938\u0906\u0908\u0906\u0930 \u2013 \u0906\u0908\u0906\u0908\u090f\u092e, \u091c\u092e\u094d\u092e\u0942 \u0915\u094b \u0921\u0940\u0906\u0908\u0921\u0940\u090f\u0938\u0940 \u0907\u0902\u0921\u093f\u092f\u093e \u0905\u0935\u0949\u0930\u094d\u0921\u094d\u0938 2026 \u092e\u0947\u0902 \u201c\u0915\u094c\u0936\u0932 \u090f\u0935\u0902 \u0909\u091a\u094d\u091a \u0936\u093f\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0905\u0917\u094d\u0930\u0923\u0940 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\u201d \u0915\u093e \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342222",
      "\u0938\u0940\u090f\u0938\u0906\u0908\u0906\u0930-\u090f\u0928\u0906\u0908\u090f\u0938\u0938\u0940\u092a\u0940\u0906\u0930 \u0928\u0947 \u092a\u0941\u0938\u094d\u0924\u0915\u093e\u0932\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u0924\u094d\u0924\u093e \u092a\u0930 \u0915\u094d\u0937\u092e\u0924\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342095",
      "\u0908\u092e\u093e\u0928\u0926\u093e\u0930 \u0930\u0939\u0947\u0902, \u0927\u0948\u0930\u094d\u092f \u0930\u0916\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0915\u0932\u093e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0935\u092b\u093c\u093e\u0926\u093e\u0930 \u0930\u0939\u0947\u0902: \u092e\u0941\u0915\u0947\u0936 \u091b\u093e\u092c\u0921\u093c\u093e \u0928\u0947 \u0907\u092b\u093c\u094d\u092b\u093c\u0940 2026 \u092e\u093e\u0938\u094d\u091f\u0930\u0915\u094d\u0932\u093e\u0938 \u092e\u0947\u0902 \u0915\u093e\u0938\u094d\u091f\u093f\u0902\u0917 \u0914\u0930 \u0905\u092d\u093f\u0928\u092f \u0915\u0947 \u0930\u0939\u0938\u094d\u092f \u0938\u093e\u091d\u093e \u0915\u093f\u090f",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342101",
      "\u0938\u094c\u0930 \u0915\u0923 \u0918\u091f\u0928\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u093e \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e \u091c\u093c\u092e\u0940\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0905\u0935\u0932\u094b\u0915\u0928\u094b\u0902 \u0915\u0947 \u092d\u094c\u0917\u094b\u0932\u093f\u0915 \u0926\u093e\u092f\u0930\u0947 \u0915\u094b \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u093e \u0939\u0948",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342107",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u090f\u0935\u0902 \u092a\u0930\u094d\u092f\u091f\u0928 \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0917\u091c\u0947\u0902\u0926\u094d\u0930 \u0938\u093f\u0902\u0939 \u0936\u0947\u0916\u093e\u0935\u0924 \u0928\u0947 \u0936\u094d\u0930\u0940 \u0917\u0941\u0930\u0941 \u0924\u0947\u0917 \u092c\u0939\u093e\u0926\u0941\u0930 \u091c\u0940 \u0915\u0947 350\u0935\u0947\u0902 \u0936\u0939\u0940\u0926\u0940 \u0926\u093f\u0935\u0938 \u0915\u0947 \u0938\u094d\u092e\u0930\u0923\u094b\u0924\u094d\u0938\u0935 \u0915\u0947 \u0938\u092e\u093e\u092a\u0928 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342159",
      "\u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0926\u093f\u0935\u0938 2026 \u0915\u0947 \u0905\u0935\u0938\u0930 \u092a\u0930 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0915\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0938\u092d\u0940 22 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u091c\u093e\u0930\u0940",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342172",
      "\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u091a\u093f\u0935 \u0936\u094d\u0930\u0940\u092e\u0924\u0940 \u092a\u0941\u0923\u094d\u092f \u0938\u0932\u093f\u0932\u093e \u0936\u094d\u0930\u0940\u0935\u093e\u0938\u094d\u0924\u0935 \u0928\u0947 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0928\u0930\u0947\u0928\u094d\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915 \u0928\u093f\u0935\u0947\u0936 \u0914\u0930 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915-\u0928\u093f\u091c\u0940 \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940 \u092a\u0930 \u091c\u094b\u0930 \u0926\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u094b \u0930\u0947\u0916\u093e\u0902\u0915\u093f\u0924 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342138",
      "\u092c\u093f\u0939\u093e\u0930 \u0915\u0947 \u092a\u091f\u0928\u093e \u092e\u0947\u0902 \u2018\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0926\u0941\u0917\u094d\u0927 \u0926\u093f\u0935\u0938 2026\u2019 \u092e\u0928\u093e\u092f\u093e \u0917\u092f\u093e; \u0907\u0938 \u0905\u0935\u0938\u0930 \u092a\u0930 \u0915\u0908 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092a\u0939\u0932\u094b\u0902 \u0915\u093e \u0936\u0941\u092d\u093e\u0930\u0902\u092d \u0914\u0930 \u0921\u0947\u092f\u0930\u0940 \u0924\u0925\u093e \u092a\u0936\u0941\u0927\u0928 \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u092a\u094d\u0930\u092e\u0941\u0916 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0922\u093e\u0902\u091a\u093e \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u093e \u0932\u094b\u0915\u093e\u0930\u094d\u092a\u0923 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342183",
      "\u0909\u092a\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0928\u0947 \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0926\u093f\u0935\u0938 \u0915\u0947 \u0905\u0935\u0938\u0930 \u092a\u0930 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0915\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0902\u0938\u094d\u0915\u0930\u0923\u094b\u0902 \u0915\u093e \u0938\u092d\u0940 22 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u0935\u093f\u092e\u094b\u091a\u0928 \u0915\u093f\u092f\u093e",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342073",
      "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 (\u092a\u0940\u090f\u092e\u090f) \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0938\u092e\u094d\u092e\u093e\u0928\u093f\u0924 \u092a\u0939\u0932\u094b\u0902 \u0915\u0940 \u0928\u093f\u0930\u0902\u0924\u0930\u0924\u093e \u0914\u0930 \u092a\u0941\u0928\u0930\u093e\u0935\u0943\u0924\u094d\u0924\u093f \u0935\u093f\u0937\u092f \u092a\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0936\u093e\u0938\u0928 \u0935\u0947\u092c\u093f\u0928\u093e\u0930 \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u0915\u093e 42\u0935\u093e\u0902 \u0935\u0947\u092c\u093f\u0928\u093e\u0930 26 \u0928\u0935\u0902\u092c\u0930, 2026 \u0915\u094b \u0906\u092f\u094b\u091c\u093f\u0924",
      "    https://pib.gov.in/PressReleaseIframePage.aspx?PRID=2342055"
